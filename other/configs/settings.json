// =============================================================================
// settings.json — user-editable app preferences
// =============================================================================
// Location (dev):     <repo>/other/configs/settings.json
// Location (install): <folder next to the .exe>/other/configs/settings.json
//
// How to use:
//   1. Edit values below and save.
//   2. Changes apply automatically while the app is running (file watcher).
//      Use Ctrl+, to open this folder from the app.
//   3. Unknown keys are ignored; missing keys fall back to defaults.
//   4. Comments (// and /* */) are allowed — this is JSONC, not strict JSON.
//
// Do NOT store window width/height/position here (geometry is handled by the
// window-state plugin; writing it caused move/flash issues).
// =============================================================================
{
  // Theme preference for the UI shell (case-insensitive; short aliases OK).
  //
  // Fixed (ignore OS light/dark):
  //   "nord-polar-night" | "polar-night"     — dark Polar Night
  //   "nord-snow-storm"  | "snow-storm"      — light Snow Storm
  //   "nord-frost-dark"  | "frost-dark"      — Frost dark only
  //   "nord-frost-light" | "frost-light"     — Frost light only
  //   "nord-aurora-dark" | "aurora-dark"     — Aurora dark only
  //   "nord-aurora-light"| "aurora-light"    — Aurora light only
  //
  // Follow OS light/dark (re-apply when the system scheme changes):
  //   "system"                               — polar-night ↔ snow-storm
  //   "nord-frost"       | "frost"           — frost dark ↔ frost light
  //   "nord-aurora"      | "aurora"          — aurora dark ↔ aurora light
  "theme": "system",

  // Font family for the app chrome.
  // Known mapped faces (recommended):
  //   "Terminus" (default), "Ubuntu", "Fira Code", "Plus Jakarta Sans"
  // Any other name is used as a CSS font-family with Terminus fallback.
  "fontFamily": "Terminus",

  // Base UI font size in CSS pixels (positive number; default 14).
  "fontSize": 14,

  // If true, hide the main window on launch (pair with tray / window.show).
  "startMinimized": false,

  // If true, launch the app when the OS signs in.
  "autostart": false,

  // If true, keep the main window above other windows.
  "alwaysOnTop": false
}
