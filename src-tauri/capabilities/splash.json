{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "splash",
  "description": "Minimal ACL for the one-shot splash window (settings/appinfo + window close).",
  "windows": ["splash"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:event:default",
    "allow-app-commands",
    "log:default"
  ]
}
