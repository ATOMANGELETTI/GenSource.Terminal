{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./.tsbuildinfo-app",
    "noEmit": true,
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["../app"]
}
