{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./.tsbuildinfo-node",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "./vite.config.ts",
    "./vitest.config.ts",
    "./playwright.config.ts",
    "./middleware.ts"
  ]
}
